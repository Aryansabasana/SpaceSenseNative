# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/spacesense

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# AI Service URL
AI_SERVICE_URL=http://127.0.0.1:8000

# Object Storage (Cloudinary - optional until media upload milestone)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
